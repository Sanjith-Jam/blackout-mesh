{
  "name": "prioritygrid-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:history": "node scripts/test-history.mjs",
    "test:contract": "node scripts/test-contract.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate-client": "PYTHONPATH=../backend python3 ../backend/scripts/export_openapi.py && npx openapi-typescript ../openapi.json -o src/schema.d.ts",
    "check-client": "npm run generate-client && git diff --exit-code ../openapi.json src/schema.d.ts || (echo 'Generated API contract is out of sync! Please run generate-client.' && exit 1)"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
