{
  "name": "prioritygrid-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-client": "PYTHONPATH=../backend python3 ../backend/scripts/export_openapi.py && npx openapi-typescript ../openapi.json -o src/schema.d.ts",
    "check-client": "npm run generate-client && git diff --exit-code src/schema.d.ts || (echo 'Generated schema is out of sync! Please run generate-client.' && exit 1)"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
