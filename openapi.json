{
  "openapi": "3.1.0",
  "info": {
    "title": "PriorityGrid API",
    "description": "Backend API for the PriorityGrid decision-and-control application.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "HealthCheck",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshot": {
      "get": {
        "summary": "Get Snapshot",
        "operationId": "GetSnapshot",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/model/status": {
      "get": {
        "summary": "Model Status",
        "operationId": "ModelStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visualizers/classrooms": {
      "get": {
        "summary": "Get Classroom Demo",
        "operationId": "GetClassroomDemo",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassroomDemoSnapshot"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Act Classroom Demo",
        "operationId": "ActClassroomDemo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassroomDemoAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassroomDemoSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visualizers/hospital": {
      "get": {
        "summary": "Get Hospital Demo",
        "operationId": "GetHospitalDemo",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitalDemoSnapshot"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Act Hospital Demo",
        "operationId": "ActHospitalDemo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HospitalDemoAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitalDemoSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/activity/observations": {
      "post": {
        "summary": "Post Activity Observation",
        "operationId": "PostActivityObservation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityObservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityObservationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/replay": {
      "post": {
        "summary": "Replay Action",
        "operationId": "ReplayAction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rfid/scan": {
      "post": {
        "summary": "Process Rfid Scan",
        "operationId": "ProcessRfidScan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RfidScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RfidScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulation/capacity": {
      "post": {
        "summary": "Change Capacity",
        "operationId": "ChangeCapacity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapacityChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapacityChangeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulation/classroom-load": {
      "post": {
        "summary": "Change Classroom Load",
        "operationId": "ChangeClassroomLoad",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassroomLoadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassroomLoadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulation/feeder": {
      "post": {
        "summary": "Change Feeder",
        "operationId": "ChangeFeeder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeederChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeederChangeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityObservationRequest": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "title": "Classroom Id"
          },
          "temperature_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature C"
          },
          "humidity_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Humidity Pct"
          },
          "co2_ppm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Co2 Ppm"
          },
          "humidity_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Humidity Ratio"
          },
          "observed_at": {
            "type": "string",
            "title": "Observed At"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id",
          "observed_at",
          "source"
        ],
        "title": "ActivityObservationRequest"
      },
      "ActivityObservationResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "applied": {
            "type": "boolean",
            "title": "Applied"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "activity": {
            "$ref": "#/components/schemas/ActivitySnapshot"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "applied",
          "revision",
          "activity"
        ],
        "title": "ActivityObservationResponse"
      },
      "ActivitySnapshot": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "state",
          "reason",
          "model_version",
          "priority"
        ],
        "title": "ActivitySnapshot"
      },
      "AllocationSnapshot": {
        "properties": {
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "critical_shortfall_w": {
            "type": "integer",
            "title": "Critical Shortfall W"
          },
          "served_w": {
            "type": "integer",
            "title": "Served W"
          },
          "baseline_mask": {
            "type": "integer",
            "title": "Baseline Mask"
          }
        },
        "type": "object",
        "required": [
          "objective",
          "critical_shortfall_w",
          "served_w",
          "baseline_mask"
        ],
        "title": "AllocationSnapshot"
      },
      "CapacityChangeRequest": {
        "properties": {
          "capacity_w": {
            "type": "integer",
            "maximum": 20000.0,
            "minimum": 0.0,
            "title": "Capacity W"
          }
        },
        "type": "object",
        "required": [
          "capacity_w"
        ],
        "title": "CapacityChangeRequest"
      },
      "CapacityChangeResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "new_capacity_w": {
            "type": "integer",
            "title": "New Capacity W"
          },
          "control_revision": {
            "type": "integer",
            "title": "Control Revision"
          },
          "config_hash": {
            "type": "string",
            "title": "Config Hash",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "new_capacity_w",
          "control_revision"
        ],
        "title": "CapacityChangeResponse"
      },
      "ClassroomDemoAction": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "scan",
              "unscan",
              "normal",
              "overload",
              "reset"
            ],
            "title": "Action"
          },
          "classroom_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "CR1",
                  "CR2",
                  "CR3"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Classroom Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ClassroomDemoAction"
      },
      "ClassroomDemoLoad": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "watts": {
            "type": "integer",
            "title": "Watts"
          },
          "essential": {
            "type": "boolean",
            "title": "Essential"
          },
          "served": {
            "type": "boolean",
            "title": "Served"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "watts",
          "essential",
          "served",
          "reason"
        ],
        "title": "ClassroomDemoLoad"
      },
      "ClassroomDemoRoom": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "rfid_active": {
            "type": "boolean",
            "title": "Rfid Active"
          },
          "loads": {
            "items": {
              "$ref": "#/components/schemas/ClassroomDemoLoad"
            },
            "type": "array",
            "title": "Loads"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "rfid_active",
          "loads"
        ],
        "title": "ClassroomDemoRoom"
      },
      "ClassroomDemoSnapshot": {
        "properties": {
          "contract": {
            "$ref": "#/components/schemas/CrossRouteContract"
          },
          "capacity_w": {
            "type": "integer",
            "title": "Capacity W"
          },
          "requested_w": {
            "type": "integer",
            "title": "Requested W"
          },
          "served_w": {
            "type": "integer",
            "title": "Served W"
          },
          "shortfall_w": {
            "type": "integer",
            "title": "Shortfall W"
          },
          "selected_classroom_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Classroom Id"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/ClassroomDemoRoom"
            },
            "type": "array",
            "title": "Rooms"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "policy": {
            "type": "string",
            "title": "Policy"
          }
        },
        "type": "object",
        "required": [
          "contract",
          "capacity_w",
          "requested_w",
          "served_w",
          "shortfall_w",
          "rooms",
          "mode",
          "policy"
        ],
        "title": "ClassroomDemoSnapshot"
      },
      "ClassroomInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "service_id": {
            "type": "string",
            "title": "Service Id"
          },
          "rfid_card_registered": {
            "type": "boolean",
            "title": "Rfid Card Registered"
          },
          "led_bit": {
            "type": "integer",
            "title": "Led Bit"
          },
          "load_event_active": {
            "type": "boolean",
            "title": "Load Event Active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "service_id",
          "rfid_card_registered",
          "led_bit",
          "load_event_active"
        ],
        "title": "ClassroomInfo"
      },
      "ClassroomLoadRequest": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "title": "Classroom Id"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "classroom_id",
          "active"
        ],
        "title": "ClassroomLoadRequest"
      },
      "ClassroomLoadResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "classroom_id": {
            "type": "string",
            "title": "Classroom Id"
          },
          "load_event_active": {
            "type": "boolean",
            "title": "Load Event Active"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "classroom_id",
          "load_event_active"
        ],
        "title": "ClassroomLoadResponse"
      },
      "ClassroomZone": {
        "properties": {
          "active_classroom_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Classroom Id"
          },
          "recent_rfid_scan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recent Rfid Scan"
          },
          "rfid_reader_status": {
            "$ref": "#/components/schemas/RfidReaderStatus",
            "default": "NOT_CONNECTED"
          },
          "classrooms": {
            "items": {
              "$ref": "#/components/schemas/ClassroomInfo"
            },
            "type": "array",
            "title": "Classrooms"
          }
        },
        "type": "object",
        "required": [
          "classrooms"
        ],
        "title": "ClassroomZone"
      },
      "CrossRouteContract": {
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/RunIdentity"
          },
          "campus_totals": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScopeTotals"
              },
              {
                "type": "null"
              }
            ]
          },
          "zone_totals": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ScopeTotals"
            },
            "type": "object",
            "title": "Zone Totals",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "identity"
        ],
        "title": "CrossRouteContract"
      },
      "FacilityZones": {
        "properties": {
          "hospital": {
            "$ref": "#/components/schemas/HospitalZone"
          },
          "classroom": {
            "$ref": "#/components/schemas/ClassroomZone"
          }
        },
        "type": "object",
        "required": [
          "hospital",
          "classroom"
        ],
        "title": "FacilityZones"
      },
      "FeederChangeRequest": {
        "properties": {
          "feeder": {
            "type": "string",
            "title": "Feeder"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "feeder",
          "available"
        ],
        "title": "FeederChangeRequest"
      },
      "FeederChangeResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "feeder": {
            "type": "string",
            "title": "Feeder"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "control_revision": {
            "type": "integer",
            "title": "Control Revision"
          },
          "config_hash": {
            "type": "string",
            "title": "Config Hash",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "feeder",
          "available",
          "control_revision"
        ],
        "title": "FeederChangeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HardwareLinkStatus": {
        "type": "string",
        "enum": [
          "NOT_CONNECTED",
          "CONNECTED",
          "ERROR"
        ],
        "title": "HardwareLinkStatus"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "application": {
            "type": "string",
            "title": "Application"
          }
        },
        "type": "object",
        "required": [
          "status",
          "application"
        ],
        "title": "HealthResponse"
      },
      "HospitalDemoAction": {
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "normal",
              "overload",
              "cooling_failure",
              "upstream_loss",
              "missing_sensor"
            ],
            "title": "Scenario"
          }
